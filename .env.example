# =============================================================================
# v54 — IA NEMOTRON (NVIDIA) — Bateu IA (/ia)
# O browser NUNCA conhece a chave: produção = edge function `nemotron-chat`
# com o segredo NVIDIA_API_KEY; dev/testes = proxy local (server/ia-proxy.mjs).
# =============================================================================
# NVIDIA_API_KEY=               # segredo da edge function: supabase secrets set NVIDIA_API_KEY=...
# IA_NEMOTRON_KEY=              # chave do proxy LOCAL — vem de .env.ia (gitignored, nunca commitar)
# IA_UPSTREAM=https://integrate.api.nvidia.com/v1
# IA_PORTA=8788                 # porta do proxy local
# VITE_IA_ENDPOINT=             # sobrepõe o endpoint do cliente (proxy local: http://localhost:8788/api/ia/chat)
# VITE_NEMOTRON_DIRECTO=0       # 1 = chamada DIRECTA dev com VITE_NVIDIA_API_KEY (a chave fica no bundle — NUNCA em produção)
# VITE_NVIDIA_API_KEY=

# =============================================================================
# v55 — IA VISÃO + VETORES (NVIDIA) — abas «Ver» e «Buscar» da Bateu IA
# Mesma chave NVIDIA_API_KEY; as rotas novas do proxy local (server/ia-proxy.mjs):
#   POST /api/ia/visao   → chat/completions multimodal (content parts + reasoning_budget)
#   POST /api/ia/vetores → embeddings multimodais (modality text_image)
# =============================================================================
# VITE_IA_ENDPOINT_VISAO=       # proxy local: http://localhost:8788/api/ia/visao
# VITE_IA_ENDPOINT_VETORES=     # proxy local: http://localhost:8788/api/ia/vetores
